<script src="/js/usuarios/listagem.js"></script>

<h1>Usuários cadastrados</h1>
<div class="d-flex justify-content-between mb-3">
    <a class="btn btn-secondary" style="width: 200px;" href="usuarios/cadastrar">Novo Usuário</a>
    <a class="btn btn-danger" style="width: 200px;" href="/">Home</a>
</div>

<hr>
    <div>
        <table class="table table-striped">
            <thead>
                <th>Id</th>
                <th>Email</th>
                <th>Nome</th>
                <th>Perfil</th>
                <th>Ativo</th>
                <th>Ações</th>
            </thead>
            <tbody>
                <% lista.forEach(u => { %>
                    <tr>
                        <td><%= u.id %></td>
                        <td><%= u.email %></td>
                        <td><%= u.nome %></td>
                        <td><%= (u.perfil && u.perfil.descricao) ? u.perfil.descricao : "Sem perfil" %></td>
                        <td>
                            <% if (u.ativo) { %>
                                <span class="badge badge-success">Ativo</span>
                            <% } else { %>
                                <span class="badge badge-secondary">Inativo</span>
                            <% } %>
                        </td>
                        <td>
                            <a href="/usuarios/alterar/<%= u.id %>" class="btn btn-primary"><i class="fas fa-pen"></i></a>
                            <button data-codigoexclusao="<%= u.id %>" class="btn btn-danger btnExclusao"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
