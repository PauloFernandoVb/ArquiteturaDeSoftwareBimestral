<script src="/js/usuarios/listagem.js"></script>

<h1>Usuários cadastrados</h1>
<a class="btn btn-secondary" style="max-width: 200px;" href="usuarios/cadastrar">Novo Usuário</a>

<hr>
    <div>
        <table class="table table-striped">
            <thead>
                <th>Id</th>
                <th>Email</th>
                <th>Nome</th>
                <th>Perfil</th>
                <th>Ativo</th>
                <th>Ações</th>
            </thead>
            <tbody>
                <% lista.forEach(u => { %>
                    <tr>
                        <td><%= u.usuarioId %></td>
                        <td><%= u.usuarioEmail %></td>
                        <td><%= u.usuarioNome %></td>
                        <td><%= (u.perfilId && u.perfilId.perfilDescricao) ? u.perfilId.perfilDescricao : u.perfilId %></td>
                        <td><%= u.usuarioAtivo %></td>
                        <td>
                            <a href="/usuarios/alterar/<%= u.usuarioId %>" class="btn btn-primary"><i class="fas fa-pen"></i></a>
                            <button data-codigoexclusao="<%= u.usuarioId %>" class="btn btn-danger btnExclusao"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
